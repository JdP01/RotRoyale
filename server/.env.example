# Rot Royale Nakama server
# Copy to .env before running docker compose.

POSTGRES_DB=nakama
POSTGRES_USER=nakama
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

CONSOLE_USERNAME=admin
CONSOLE_PASSWORD=change-me

# Comma-separated or single origin values consumed by Nakama's http_server.allowed_origins.
# Example for one site:
# ALLOWED_ORIGINS=https://rotroyale.example.com
ALLOWED_ORIGINS=https://rotroyale.example.com
